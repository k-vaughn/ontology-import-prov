// Diagram for Insertion
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	Insertion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Insertion</TD></TR></TABLE>> URL="../Insertion" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		owl_Thing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">owl:Thing</TD></TR></TABLE>> URL="https://w3id.org/citydata/imported/owl/Thing" margin=0]
	}
	Derivation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Derivation</TD></TR></TABLE>> URL="../Derivation" margin=0]
	Insertion -> Derivation [arrowhead=onormal style=solid]
	Insertion -> Invis [style=invis]
	Invis -> owl_Thing [style=invis]
	Insertion -> owl_Thing [label=" dictionary 
 «exactly 1»  " arrowhead=normal style=solid]
	Insertion -> owl_Thing [label=" insertedKeyEntityPair 
 «min 1»  " arrowhead=normal style=solid]
}
