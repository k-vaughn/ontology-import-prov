    rdfs:isDefinedBy prov: ;
    rdfs:range :Removal ;
    rdfs:subPropertyOf :qualifiedDerivation ;
    skos:definition "prov:qualifiedRemoval shows the details of a removal, in particular the removed keys." ;
    :category "collections" ;
